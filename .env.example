# FastAPI backend base URL
NEXT_PUBLIC_API_URL=
# Supabase project (Auth). Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ================= Billing (server-only — NEVER prefix with NEXT_PUBLIC_) =================
# Public URL of this app. Local: http://localhost:3000. For PayFast IPN locally use your ngrok URL.
APP_URL=http://localhost:3000
# Supabase -> Project Settings -> API Keys -> service_role (secret). Used by webhooks to update plans.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (test mode) ----
# dashboard.stripe.com -> toggle "Test mode" -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_test_
# Local: run `stripe listen --forward-to localhost:3000/api/billing/stripe/webhook` and copy the whsec_ it prints.
# Deployed: Developers -> Webhooks -> add endpoint https://<domain>/api/billing/stripe/webhook
#   events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_

# ---- PayFast Pakistan (gopayfast.com) ----
# Apply as a merchant and request sandbox/UAT credentials. Leave both blank to use the dev stub.
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_MERCHANT_NAME=Kyro
# UAT/sandbox endpoint; switch to the live URL PayFast gives you for production.
PAYFAST_BASE_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction
# Set to true to force the stub even in production builds (demo only).
PAYFAST_STUB=

# ---- Plan prices (optional overrides; defaults shown) ----
PRICE_STARTER_USD_CENTS=1900
PRICE_PRO_USD_CENTS=4900
PRICE_STARTER_PKR=5000
PRICE_PRO_PKR=13500
