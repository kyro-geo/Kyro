# Same Supabase project as the frontend. Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated frontend origins allowed to call this API (CORS)
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-APP.vercel.app
# Keep in sync with the frontend's price overrides
PRICE_STARTER_USD_CENTS=1900
PRICE_PRO_USD_CENTS=4900
